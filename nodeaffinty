apiVersion: v1
kind: Pod
metadata:
  name: mypod-required
spec:
  containers:
  - name: nginx
    image: nginx
  affinity:
    nodeAffinity:
      requiredDuringSchedulingIgnoredDuringExecution:
        nodeSelectorTerms:
        - matchExpressions:
          - key: disktype   # Node का label key
            operator: In
            values:
            - ssd          # Node का label value

